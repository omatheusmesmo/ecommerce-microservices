<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="1-index-products-category" author="ecommerce">
        <ext:createIndex collectionName="products">
            <ext:keys>
                { categoryId: 1 }
            </ext:keys>
            <ext:options>
                { name: "idx_products_categoryId" }
            </ext:options>
        </ext:createIndex>
    </changeSet>

    <changeSet id="2-index-products-active" author="ecommerce">
        <ext:createIndex collectionName="products">
            <ext:keys>
                { active: 1 }
            </ext:keys>
            <ext:options>
                { name: "idx_products_active" }
            </ext:options>
        </ext:createIndex>
    </changeSet>

    <changeSet id="3-index-categories-parentId" author="ecommerce">
        <ext:createIndex collectionName="categories">
            <ext:keys>
                { parentId: 1 }
            </ext:keys>
            <ext:options>
                { name: "idx_categories_parentId" }
            </ext:options>
        </ext:createIndex>
    </changeSet>

    <changeSet id="4-index-products-variants-sku" author="ecommerce">
        <ext:createIndex collectionName="products">
            <ext:keys>
                { "variants.sku": 1 }
            </ext:keys>
            <ext:options>
                { name: "idx_products_variants_sku", unique: true, sparse: true }
            </ext:options>
        </ext:createIndex>
    </changeSet>
</databaseChangeLog>

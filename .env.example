# ========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill with your values:
#   cp .env.example .env
# ========================================

# ========================================
# KAFKA
# ========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ========================================
# POSTGRESQL (Order Service)
# ========================================
POSTGRES_DB=orderdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ========================================
# MONGODB (Product Service)
# ========================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_INITDB_DATABASE=productdb

# ========================================
# GRAFANA
# ========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ========================================
# MICROSERVICES - ORDER SERVICE
# ========================================
ORDER_SERVICE_DB_URL=jdbc:postgresql://postgres:5432/orderdb
ORDER_SERVICE_DB_USER=admin
ORDER_SERVICE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ========================================
# MICROSERVICES - PRODUCT SERVICE
# ========================================
PRODUCT_SERVICE_MONGODB_URI=mongodb://admin:CHANGE_ME_STRONG_PASSWORD@mongodb:27017
PRODUCT_SERVICE_MONGODB_DATABASE=productdb
PRODUCT_SERVICE_REDIS_URI=redis://redis:6379

# ========================================
# MICROSERVICES - NOTIFICATION SERVICE
# ========================================
# Get your Discord webhook from: Discord Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_ENABLED=true
NOTIFICATION_DISCORD_ENABLED=true

# Get your Brevo API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-YOUR_API_KEY_HERE
BREVO_SENDER_NAME=BestEcommerce
BREVO_SENDER_EMAIL=noreply@example.com
NOTIFICATION_EMAIL_ENABLED=false

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true

# ========================================
# SECURITY
# ========================================
# Path to JWT keys (generate with: openssl ecparam -name secp256r1 -genkey -noout -out privateKey.pem)
JWT_KEY_LOCATION=/work/privateKey.pem
JWT_PUBLIC_KEY_LOCATION=/work/publicKey.pem

# ========================================
# AUTHENTICATION SERVICE
# ========================================
# Strong password for admin user (minimum 12 characters, use special chars)
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Encryption key for sensitive data (generate with: openssl rand -hex 16)
ENCRYPTION_KEY=CHANGE_ME_32_HEX_CHARACTERS

# Frontend base URL for email links
FRONTEND_BASE_URL=https://yourapp.example.com

# Allowed CORS origins (comma-separated) for browser calls from the frontend
CORS_ORIGINS=https://yourapp.example.com

# Authentication Service PostgreSQL
AUTH_POSTGRES_DB=authdb
AUTH_POSTGRES_USER=authuser
AUTH_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Authentication Service DB Connection
AUTH_SERVICE_DB_URL=jdbc:postgresql://postgres-auth:5432/authdb
AUTH_SERVICE_DB_USER=authuser
AUTH_SERVICE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

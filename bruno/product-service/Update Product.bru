meta {
  name: Update Product (Admin-Seller)
  type: http
  seq: 4
}

put {
  url: http://localhost:8082/products/{{productId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Gaming Laptop Pro",
    "description": "Updated description",
    "price": {
      "amount": 1299.00,
      "currency": "BRL"
    },
    "stock": 5,
    "categoryId": "{{categoryId}}"
  }
}

meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: http://localhost:8081/orders
  body: json
  auth: none
}

body:json {
  {
    "customerName": "John Doe",
    "customerEmail": "user@example.com",
    "shippingCost": {
      "amount": 15.00,
      "currency": "BRL"
    },
    "items": [
      {
        "productId": "{{productId}}",
        "productName": "Gaming Laptop",
        "quantity": 1,
        "unitPrice": {
          "amount": 1200.00,
          "currency": "BRL"
        }
      }
    ]
  }
}

vars:post-response {
  orderId: res.body.id
}
